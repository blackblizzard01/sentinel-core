# .env.example
# ============================================================
# SENTINEL AI — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your own values.
# NEVER commit .env to GitHub. Only .env.example gets committed.
# ============================================================

# ─── GROQ API KEYS (console.groq.com) ────────────────────────
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here
GROQ_API_KEY_5=your_groq_api_key_5_here

# ─── GOOGLE GEMINI API KEYS (aistudio.google.com) ────────────
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here

# ─── DEEPSEEK API KEYS (platform.deepseek.com) ───────────────
DEEPSEEK_API_KEY_1=your_deepseek_api_key_1_here
DEEPSEEK_API_KEY_2=your_deepseek_api_key_2_here
DEEPSEEK_API_KEY_3=your_deepseek_api_key_3_here
DEEPSEEK_API_KEY_4=your_deepseek_api_key_4_here
DEEPSEEK_API_KEY_5=your_deepseek_api_key_5_here

# ─── ANTHROPIC (optional) ────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── OPENAI (optional) ───────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here

# ─── DATABASE ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/postgres

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CHROMADB ────────────────────────────────────────────────
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── FASTAPI ─────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── GITHUB ──────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here

# ─── ENVIRONMENT ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
