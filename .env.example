# .env.example
# ============================================================
# SENTINEL AI — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your own values.
# NEVER commit .env to GitHub. Only .env.example gets committed.
# Share actual keys via Doppler or encrypted message only.
# ============================================================

# ─── LLM API KEYS ────────────────────────────────────────────
# ─── GROQ API KEYS (get one per teammate — console.groq.com) ─
# Free, no credit card, 14400 requests/day per key
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_here
GROQ_API_KEY_3=your_groq_api_key_here
GROQ_API_KEY_4=your_groq_api_key_here
GROQ_API_KEY_5=your_groq_api_key_here

# ─── GOOGLE GEMINI API KEYS (get one per teammate — aistudio.google.com) ─
# Free, no credit card needed
# Used for: ReportAgent, AutopatchAgent (replaces Anthropic Claude)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_here
GEMINI_API_KEY_3=your_gemini_api_key_here
GEMINI_API_KEY_4=your_gemini_api_key_here
GEMINI_API_KEY_5=your_gemini_api_key_here

# ─── DEEPSEEK API KEYS (platform.deepseek.com) ───────────────
# Free credits on signup
# Used for: AutopatchAgent backup (excellent at code generation)
DEEPSEEK_API_KEY_1=your_deepseek_api_key_here
DEEPSEEK_API_KEY_2=your_deepseek_api_key_here
DEEPSEEK_API_KEY_3=your_deepseek_api_key_here
DEEPSEEK_API_KEY_4=your_deepseek_api_key_here
DEEPSEEK_API_KEY_5=your_deepseek_api_key_here

# ─── DATABASE ────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:your_strong_password_here@localhost:5432/sentinel_db

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CHROMADB ────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── FASTAPI ─────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── GITHUB (for Autopatch Agent PR creation) ────────────────
GITHUB_TOKEN=your_github_personal_access_token_here

# ─── ENVIRONMENT ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
