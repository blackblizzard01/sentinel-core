# .env.example
# ============================================================
# SENTINEL AI — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your own values.
# NEVER commit .env to GitHub. Only .env.example gets committed.
# Share actual keys via Doppler or encrypted message only.
# ============================================================

# ─── LLM API KEYS ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── DATABASE ────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel:your_strong_password_here@localhost:5432/sentinel_db

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CHROMADB ────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── FASTAPI ─────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── GITHUB (for Autopatch Agent PR creation) ────────────────
GITHUB_TOKEN=your_github_personal_access_token_here

# ─── ENVIRONMENT ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
